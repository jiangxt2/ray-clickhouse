{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiangxt2/ray-clickhouse/comparison/manifest.schema.json",
  "title": "Ray ClickHouse comparison manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "harness", "official", "external", "provenance", "environment", "scenario_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "harness": {"$ref": "#/$defs/identity"},
    "official": {"$ref": "#/$defs/identity"},
    "external": {"$ref": "#/$defs/identity"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_sha", "harness_commit", "workflow_sha"],
      "properties": {
        "candidate_sha": {"$ref": "#/$defs/commit"},
        "harness_commit": {"$ref": "#/$defs/commit"},
        "workflow_sha": {"$ref": "#/$defs/commit"}
      }
    },
    "environment": {"type": "object", "additionalProperties": {"type": ["string", "integer", "number", "boolean", "null"]}},
    "scenario_digest": {"$ref": "#/$defs/sha256"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "size"],
        "properties": {
          "name": {"type": "string"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "filename", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*\\.whl$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
